{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeraRAW Beta",
  "version": "0.1.8",
  "identifier": "co.meratech.editor",
  "mainBinaryName": "meratech-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": false
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MeraRAW",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        },
        "backgroundColor": "#272727",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "capabilities": [
        "main-capability"
      ],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost frame: thumb: http://frame.localhost https://frame.localhost http://thumb.localhost https://thumb.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost frame: thumb: http://frame.localhost https://frame.localhost http://thumb.localhost https://thumb.localhost https://kaanlfnxoyrjrgqrxcuz.supabase.co wss://kaanlfnxoyrjrgqrxcuz.supabase.co https://www.meratech.co https://us.i.posthog.com https://us-assets.i.posthog.com",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Photography",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Kai Mai (ZJP5CXC3FS)",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1"
        ]
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      }
    },
    "resources": [
      "../presets/bundled/*",
      "core/models/skyseg.onnx"
    ]
  }
}
